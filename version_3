      "source": "coefs = {\n    \"UE1\": {\"R101\": 10, \"R102\": 10, \"R103\": 7, \"R104\": 7, \"R106\": 5, \"R108\": 6, \"R110\": 5,\n            \"R111\": 4, \"R112\": 2, \"R113\": 5, \"R114\": 5, \"SAE11\": 20, \"SAE12\": 20, \"SAE16\": 7},\n    \"UE2\": {\"R101\": 4, \"R103\": 2, \"R104\": 8, \"R105\": 6, \"R110\": 5, \"R111\": 5, \"R112\": 2,\n            \"R113\": 9, \"R114\": 9, \"R115\": 3, \"SAE13\": 29, \"SAE16\": 7},\n    \"UE3\": {\"R101\": 4, \"R103\": 2, \"R106\": 5, \"R107\": 15, \"R108\": 6, \"R109\": 4, \"R110\": 5,\n            \"R111\": 5, \"R112\": 2, \"R115\": 3, \"SAE14\": 20, \"SAE15\": 20, \"SAE16\": 7},\n}\n\nnotes = {\"R101\": 12, \"R102\": 9, \"R103\": 14, \"R104\": 8, \"R105\": 11, \"R106\": 10,\n         \"R107\": 15, \"R108\": 7, \"R109\": 13, \"R110\": 12, \"R111\": 14, \"R112\": 16,\n         \"R113\": 9, \"R114\": 10, \"R115\": 12, \"SAE11\": 13, \"SAE12\": 11,\n         \"SAE13\": 8, \"SAE14\": 14, \"SAE15\": 15, \"SAE16\": 12}\n\nmoyennes = {}\nfor ue in coefs:\n    somme = 0\n    total = 0\n    for nom in coefs[ue]:\n        if nom in notes:\n            somme = somme + notes[nom] * coefs[ue][nom]\n            total = total + coefs[ue][nom]\n    moyennes[ue] = round(somme / total, 2)\n\nprint(moyennes)",
